# Localized resource files: pin CRLF in the working tree so an editor/tool
# can't silently flip their line endings. (These are also stored as
# ISO-8859-1, not UTF-8 - that's an editor concern git can't enforce.)
CHCFR21_*.rc text eol=crlf

# Golden-master regression baselines: byte-exact LF files compared verbatim
# by tests/ColorMathTest - keep git from normalizing their line endings.
tests/ColorMathTest/golden/* -text

# Measurement cue waves: binary PCM, never line-ending normalized.
*.wav -text
