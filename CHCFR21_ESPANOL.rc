END

IDR_LUM_GRAPH_MENU MENU
BEGIN
    POPUP "Gráfico"
    BEGIN
        MENUITEM "Mostrar la referencia",           IDM_LUM_GRAPH_SHOWREF
        MENUITEM "Mostrar la medida de referencia",   IDM_LUM_GRAPH_DATAREF
        MENUITEM "Mostrar la media",             IDM_LUM_GRAPH_SHOW_AVG
        MENUITEM SEPARATOR
        MENUITEM "Luminancia",                   IDM_LUM_GRAPH_YLUM
        MENUITEM "Rojo",                         IDM_LUM_GRAPH_REDLUM
        MENUITEM "Verde",                       IDM_LUM_GRAPH_GREENLUM
        MENUITEM "Azul",                        IDM_LUM_GRAPH_BLUELUM
        MENUITEM SEPARATOR
        MENUITEM "Y absoluta",                  IDM_LUM_GRAPH_Yab
        MENUITEM "log(Y)",                      IDM_LUM_GRAPH_YLog
        MENUITEM "L*",                          IDM_LUM_GRAPH_L
        MENUITEM SEPARATOR
        MENUITEM "Guardar...",                     IDM_GRAPH_SAVE
        POPUP "Escala"
        BEGIN
            MENUITEM "Ajuste automático",                 IDM_GRAPH_SCALE_FIT
            POPUP "Luminancia"
            BEGIN
                MENUITEM "0-100%",                      IDM_LUMINANCE_GRAPH_Y_SCALE1
                MENUITEM "Ajuste automático",                 IDM_GRAPH_Y_SCALE_FIT
                MENUITEM "Zoom +",                      IDM_GRAPH_Y_ZOOM_IN
                MENUITEM "Zoom -",                      IDM_GRAPH_Y_ZOOM_OUT
                MENUITEM "Subir",                    IDM_GRAPH_Y_SHIFT_TOP
                MENUITEM "Bajar",                  IDM_GRAPH_Y_SHIFT_BOTTOM
            END
            MENUITEM "Valores...     ",              IDM_GRAPH_SCALE_CUSTOM
        END
        MENUITEM "Parámetros...",               IDM_GRAPH_SETTINGS
        MENUITEM SEPARATOR
        MENUITEM "&Ayuda",                       IDM_HELP
    END
END

