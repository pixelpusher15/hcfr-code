        MENUITEM "Mostrar las saturaciones",         IDM_CIE_SHOWSATURATIONSCALE
        MENUITEM "Mostrar los objetivos de saturación", IDM_CIE_SHOWSATURATIONSCALETARG
        MENUITEM "Mostrar las medidas del color checker", IDM_CIE_SHOWCCSCALE
        MENUITEM "Mostrar los objetivos del color checker", IDM_CIE_SHOWCCSCALETARG
