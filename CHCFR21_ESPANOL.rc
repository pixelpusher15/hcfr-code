IDR_MESURETYPE MENU
BEGIN
    POPUP "&Archivo"
    BEGIN
        MENUITEM "&Nuevo\tCtrl+N",                ID_FILE_NEW
        MENUITEM "&Abrir...\tCtrl+O",            ID_FILE_OPEN
        MENUITEM "&Duplicar",                  IDM_DUPLICATEDOC
        MENUITEM "&Cerrar",                      ID_FILE_CLOSE
        MENUITEM "&Guardar\tCtrl+S",               ID_FILE_SAVE
        MENUITEM "Guardar co&mo...",                 ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "Im&primir...\tCtrl+P",           ID_FILE_PRINT
        MENUITEM "Vista pre&via de impresión",              ID_FILE_PRINT_PREVIEW
        MENUITEM "Configu&rar impresión...",             ID_FILE_PRINT_SETUP
        MENUITEM SEPARATOR
        MENUITEM "Archivos recientes",                 ID_FILE_MRU_FILE1
        MENUITEM SEPARATOR
        MENUITEM "Salir",                       ID_APP_EXIT
    END
    POPUP "&Edición"
    BEGIN
        MENUITEM "Des&hacer\tCtrl+Z",               ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "Cor&tar\tCtrl+X",                ID_EDIT_CUT
        MENUITEM "C&opiar\tCtrl+C",               ID_EDIT_COPY
        MENUITEM "&Pegar\tCtrl+V",              ID_EDIT_PASTE
    END
    POPUP "&Ver"
    BEGIN
        MENUITEM "Colores de &test",                IDM_VIEW_TESTCOLOR
        MENUITEM "&Luminancia",                  IDM_VIEW_LUMINANCE
        MENUITEM SEPARATOR
        MENUITEM "Barra de herr&amientas estándar",           ID_VIEW_TOOLBAR
        MENUITEM "Barra de herramientas de &vistas",              ID_VIEW_VIEW_BAR
        MENUITEM "Barra de herramientas de &medidas",           ID_VIEW_MEASURE_BAR
        MENUITEM "Barra de herramientas de medidas &extendidas",  ID_VIEW_MEASURE_EXT_BAR
        MENUITEM "Barra de herramientas de medidas de saturación", ID_VIEW_MEASURE_SAT_BAR
        MENUITEM "Barra de e&stado",                 ID_VIEW_STATUS_BAR
        MENUITEM SEPARATOR
        MENUITEM "Pestañas arri&ba",         IDM_TOGGLE_TAB
    END
    POPUP "&Medidas"
    BEGIN
        MENUITEM "Escala de &grises",                 IDM_MEASURE_GRAYSCALE
        MENUITEM "Colores &primarios",             IDM_MEASURE_PRIMARIES
        MENUITEM "Colores &primarios y secundarios", IDM_MEASURE_SECONDARIES
        MENUITEM "Escala de &grises y colores",      IDM_MEASURE_GRAYSCALE_COLORS
        MENUITEM SEPARATOR
        MENUITEM "Escala de grises cerca del negro (near &black)",      IDM_MEASURE_NEARBLACK
        MENUITEM "Escala de grises cerca del blanco (near &white)",      IDM_MEASURE_NEARWHITE
