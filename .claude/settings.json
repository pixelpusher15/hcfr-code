{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "if": "Bash(git *)",
            "command": "$d=$env:CLAUDE_PROJECT_DIR; if(-not $d){$d=(Get-Location).Path}; & \"$d\\.claude\\hooks\\guard-git.ps1\"",
            "statusMessage": "Checking git guardrails"
          },
          {
            "type": "command",
            "shell": "powershell",
            "if": "Bash(gh *)",
            "command": "$d=$env:CLAUDE_PROJECT_DIR; if(-not $d){$d=(Get-Location).Path}; & \"$d\\.claude\\hooks\\guard-git.ps1\"",
            "statusMessage": "Checking git guardrails"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "if": "PowerShell(git *)",
            "command": "$d=$env:CLAUDE_PROJECT_DIR; if(-not $d){$d=(Get-Location).Path}; & \"$d\\.claude\\hooks\\guard-git.ps1\"",
            "statusMessage": "Checking git guardrails"
          },
          {
            "type": "command",
            "shell": "powershell",
            "if": "PowerShell(gh *)",
            "command": "$d=$env:CLAUDE_PROJECT_DIR; if(-not $d){$d=(Get-Location).Path}; & \"$d\\.claude\\hooks\\guard-git.ps1\"",
            "statusMessage": "Checking git guardrails"
          }
        ]
      }
    ]
  }
}
